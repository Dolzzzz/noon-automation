# Copy this file to .env and fill in your noon Egypt test account.
# .env is gitignored — never commit real credentials.
NOON_EMAIL=you@example.com
NOON_PASSWORD=change-me

# Optional
# HEADLESS=false     # noon is far more reliable headed; keep false for the demo
# SLOW_MO=250        # ms between actions; raise to 500+ for a video recording
# VIDEO=on           # also save Playwright's per-test videos (needs: npx playwright install ffmpeg)
